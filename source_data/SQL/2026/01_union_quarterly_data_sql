*This is the query I used to create a consolidated table containing the U.S. DoT data for 2019. This version of the query pulls uses a pair of left joins to pull in the column "Description" from a BTS auxillary table. This description offers a unique name for each OriginCityMarketID and DestCityMarketID

CREATE TABLE us_air_passenger.unioned AS
(WITH temp_table AS
(SELECT
  Origin, OriginStateName, Dest, DestStateName, Passengers, Distance, OriginState, DestState, OriginCityMarketID, DestCityMarketID
FROM `cycling-case-study-362219.us_air_passenger.2019_Q1`
UNION ALL
SELECT
  Origin, OriginStateName, Dest, DestStateName, Passengers, Distance, OriginState, DestState, OriginCityMarketID, DestCityMarketID
FROM `cycling-case-study-362219.us_air_passenger.2019_Q2`
UNION ALL
SELECT 
  Origin, OriginStateName, Dest, DestStateName, Passengers, Distance, OriginState , DestState, OriginCityMarketID, DestCityMarketID
FROM `cycling-case-study-362219.us_air_passenger.2019_Q3`
UNION ALL
SELECT
  Origin, OriginStateName, Dest, DestStateName, Passengers, Distance, OriginState, DestState, OriginCityMarketID, DestCityMarketID
FROM `cycling-case-study-362219.us_air_passenger.2019_Q4`)
SELECT 
a1.Description AS Origin_City_Market,
a2.Description AS Dest_City_Market, 
OriginCityMarketID, DestCityMarketID, 
Passengers, Distance
FROM temp_table AS full_data
LEFT JOIN `cycling-case-study-362219.us_air_passenger.CityMarketID_Lookup_Table` AS a1 ON full_data.OriginCityMarketID = a1.Description
LEFT JOIN `cycling-case-study-362219.us_air_passenger.CityMarketID_Lookup_Table` AS a2 ON full_data.DestCityMarketID = a2.Description)
